# =========================================================
# FIRE & SLICE ? Server environment configuration
# Copy this file to .env and adjust values as needed.
# =========================================================

# Port for the Express server
PORT=5000

# JWT secrets (change these in production)
JWT_ACCESS_SECRET=fire_access_dev_secret_change_me
JWT_REFRESH_SECRET=fire_refresh_dev_secret_change_me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Database
# Use a local MongoDB instance or a MongoDB Atlas connection string.
# Default local connection: mongodb://localhost:27017/fireandslice
MONGODB_URI=mongodb://localhost:27017/fireandslice
# Optional compatibility alias for older configs
# MONGO_URI=mongodb://localhost:27017/fireandslice

# Client origin (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Razorpay (optional ? demo mode is used when keys are absent)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary (optional ? image URLs are used when absent)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP / Nodemailer (optional ? order emails logged to console when absent)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FIRE & SLICE <orders@fireandslice.in>"
